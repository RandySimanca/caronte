# Supabase Configuration (Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SOLO para scripts locales)
# NUNCA exponer esta llave en el frontend ni compartirla públicamente
# Consíguela en: Supabase Dashboard → Project Settings → API → service_role (secret)
# Se usa en scripts como create-superadmin.ts
SUPABASE_SERVICE_ROLE_KEY=
