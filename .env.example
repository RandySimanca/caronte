# Supabase Configuration (Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Turnstile (CAPTCHA del login) - Site Key PÚBLICA
# Cloudflare → Turnstile → tu widget → Site Key. La Secret Key va SOLO en
# Supabase → Authentication → Attack Protection, nunca en el frontend.
# Si se deja vacía, el login funciona sin CAPTCHA.
# Para pruebas locales (siempre pasa): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Supabase Service Role Key (SOLO para scripts locales)
# NUNCA exponer esta llave en el frontend ni compartirla públicamente
# Consíguela en: Supabase Dashboard → Project Settings → API → service_role (secret)
# Se usa en scripts como create-superadmin.ts
SUPABASE_SERVICE_ROLE_KEY=
